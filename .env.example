# Supabase Configuration (PostgreSQL Database & Auth)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Server-Side Supabase Service Role Key (Only used server-side in API routes, never exposed to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional Gemini API Key
GEMINI_API_KEY=""

# App URL
APP_URL=""

